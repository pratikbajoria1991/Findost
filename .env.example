# ── Findost environment variables ──────────────────────────────────
# The site runs fully WITHOUT any of these (guest mode, console-logged
# leads). Add them as you activate each capability.

# Google sign-in (NextAuth) — console.cloud.google.com → APIs & Services
# → Credentials → OAuth client ID (Web). Authorized redirect URI:
#   https://findost.io/api/auth/callback/google   (and http://localhost:3000/... for dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with:  openssl rand -base64 32   (any long random string)
NEXTAUTH_SECRET=
# Set to the deployed URL in production (on Vercel this is auto-detected)
NEXTAUTH_URL=http://localhost:3000

# Airtable CRM — airtable.com/create/tokens (scope: data.records:write
# on your base). Base ID starts with "app", from the base's API docs.
# Table needs columns: Name, Email, Phone, Source, Message, Captured At
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Leads
